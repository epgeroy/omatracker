{
  "schemaVersion": 1,
  "id": "epgeroy.omatracker",
  "name": "OmaTracker",
  "version": "0.5.0",
  "author": "epgeroy",
  "license": "MIT",
  "description": "Agent-first project tracking, historical rates, PDF invoices and Google Drive sync",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaTracker",
    "description": "Present Rust-backed time tracking, corrections and PDF invoices",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "center",
    "schema": [
      {
        "key": "dataPath",
        "type": "string",
        "label": "Task data file",
        "defaultValue": "~/.config/omarchy/omatracker.json"
      }
    ]
  }
}
