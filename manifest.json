{
  "schemaVersion": 1,
  "id": "sophie.time-tracker",
  "name": "TimeTracker",
  "version": "0.3.0",
  "author": "epgeroy",
  "license": "MIT",
  "description": "Rust-backed project time tracking with Typst reports and Google Drive sync",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "TimeTracker",
    "description": "Present Rust-backed project time tracking and PDF reports",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "center",
    "schema": [
      {
        "key": "dataPath",
        "type": "string",
        "label": "Task data file",
        "defaultValue": "~/.config/omarchy/time-tracker.json"
      }
    ]
  }
}
